{
  "name": "@xiaoso/dsh-tool-step-note",
  "version": "0.1.0",
  "description": "Add a short model-written description argument to enabled tools and show it on the chat step row.",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "agent-tools",
    "tool-schema",
    "step-description",
    "typescript",
    "ui"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-0 <0.3.0-0"
  },
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.ts && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/inject-check.mjs",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
